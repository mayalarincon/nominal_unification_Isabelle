                   \<subset>  vars_trm t \<union> vars_eprobs xs") (* B *)
apply(simp add: psubset_card_mono)
(* B *)
apply(force)
(* A *)
apply(force)
(* second case *)
apply(subgoal_tac "finite (vars_trm t \<union> vars_eprobs xs)")
apply(drule_tac x="X" in card_insert_disjoint)
apply(simp)
apply(simp)
